# Copy to .env.asc (gitignored) and fill in your own values.
#
# Create a key at App Store Connect > Users and Access > Integrations > Keys
# with the "App Manager" role. The .p8 downloads exactly once.
#
#   mkdir -p ~/.appstoreconnect/private_keys
#   mv ~/Downloads/AuthKey_XXXXXXXXXX.p8 ~/.appstoreconnect/private_keys/
#   chmod 600 ~/.appstoreconnect/private_keys/AuthKey_XXXXXXXXXX.p8
#
# The Issuer ID is shown at the top of that same Keys page.

export ASC_KEY_ID=XXXXXXXXXX
export ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
export ASC_KEY_PATH="$HOME/.appstoreconnect/private_keys/AuthKey_XXXXXXXXXX.p8"

# Export signing. Cloud signing (signingStyle=automatic) asks Apple to mint a
# distribution certificate on demand and needs an Admin-role key; an App Manager
# key gets "Cloud signing permission error". When a distribution certificate
# already exists locally there is no reason to ask for a new one, so the script
# signs manually against a named profile.
#
# Find the profile's name with:
#
#   for f in ~/Library/Developer/Xcode/UserData/Provisioning\ Profiles/*.mobileprovision; do
#     security cms -D -i "$f" | plutil -extract Name raw -
#   done
#
# Leave both unset to attempt cloud signing instead.

export EXPORT_PROFILE="Zero Fret App Store"
export EXPORT_CERT="Apple Distribution"
